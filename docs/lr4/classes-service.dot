digraph G {
  rankdir=TB; nodesep=0.35; ranksep=0.6; fontname="Helvetica";
  node [shape=record, fontname="Helvetica", fontsize=15, style=filled, fillcolor="#F3F6FB"];
  edge [fontname="Helvetica", fontsize=12];
  Main [label="{Main|точка збирання: створює реалізації\lі передає їх у сервіс\l}", fillcolor="#FFF8E1"];
  Service [label="{DeliveryService|- method: DeliveryMethod\l- calculator: CostCalculator\l|+ DeliveryService(method, calculator)\l+ process(Order): Receipt\l}", fillcolor="#E8F5E9"];
  DM [label="«interface»\nDeliveryMethod"]; TR [label="«interface»\nTrackable", fillcolor="#FCE4EC"];
  CC [label="{«interface»\nCostCalculator|+ description()\l+ cost(Order): BigDecimal\l}"];
  Flat [label="FlatRate\nCalculator"]; WD [label="WeightDistance\nCalculator"]; Free [label="FreeAboveThreshold\nCalculator"];
  Order [label="{«record» Order|id, city, address,\lweightKg, distanceKm, value\l}"];
  Main -> Service [style=dashed, arrowhead=vee, label=" new DeliveryService(...)"];
  Service -> DM [arrowhead=vee, label=" залежність 1"];
  Service -> CC [arrowhead=vee, label=" залежність 2"];
  Service -> TR [arrowhead=vee, style=dotted, label=" якщо підтримує"];
  Service -> Order [arrowhead=vee, style=dotted];
  CC -> Flat [style=invis]; CC -> WD [style=invis]; CC -> Free [style=invis];
  Flat -> CC [arrowhead=empty, style=dashed, constraint=false]; WD -> CC [arrowhead=empty, style=dashed, constraint=false]; Free -> CC [arrowhead=empty, style=dashed, constraint=false];
  Free -> CC [arrowhead=odiamond, label=" fallback", constraint=false];
}
